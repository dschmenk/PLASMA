import event
    const MAX_EVENTS = 20
    struc t_event
        var evDelta
        var evAction
        var evParam
        var evNext
    end
    predef eventInit#0
    predef eventFree(event)#0
    predef eventNew#1
    predef doEvents#1
    predef addEvent(event, time)#0
    predef addAction(action, param, time)#0
    predef dumpEvents#0
end